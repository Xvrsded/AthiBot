# ==========================================
# Konfigurasi Lingkungan Athibot (Athi Store)
# ==========================================

# Token Bot Discord (Didapat dari Discord Developer Portal -> Bot -> Reset Token)
TOKEN=your_bot_token_here

# Client ID / Application ID Bot (Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# Guild / Server ID (ID Server Discord tempat bot beroperasi)
GUILD_ID=your_guild_id_here

# MongoDB Connection URI (Local atau MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/athibot

# Warna Embed Utama (Format HEX, default tema peach Athi Store: #FF8474)
EMBED_COLOR=#FF8474

# ID Role Staff / Admin yang menangani tiket dan order (Opsional, bisa juga via /config)
STAFF_ROLE_ID=your_staff_role_id_here

# ID Kategori Discord tetap tempat seluruh channel tiket dibuat
TICKET_CATEGORY_ID=1570431160222228541

# ID Channel untuk log tiket dan transkrip (Opsional, bisa via /config)
LOG_CHANNEL_ID=your_log_channel_id_here

# ID Channel untuk notifikasi order masuk ke staff (Opsional, bisa via /config)
ORDER_LOG_CHANNEL_ID=your_order_log_channel_id_here
